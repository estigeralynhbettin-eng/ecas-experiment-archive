{
  "$defs": {
    "evidenceItem": {
      "additionalProperties": false,
      "properties": {
        "binding_facts": {
          "additionalProperties": {
            "$ref": "#/$defs/factValue"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "bound_paths": {
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "operations": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "insufficient"
          ]
        },
        "sha256": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "business_requirement",
            "api_documentation",
            "developer_manual",
            "security_catalog",
            "runtime_context_contract"
          ]
        },
        "supports_primitives": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "system": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "versions": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "visibility": {
          "const": "visible"
        }
      },
      "required": [
        "evidence_id",
        "visibility",
        "source_kind",
        "sha256",
        "locator",
        "system",
        "versions",
        "operations",
        "relation",
        "supports_primitives",
        "bound_paths",
        "binding_facts"
      ],
      "type": "object"
    },
    "factValue": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ]
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "pointer": {
      "maxLength": 512,
      "pattern": "^/(request|trusted)(/([^~/]|~0|~1)+|/\\*)*$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "system",
        "version",
        "operation"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.invalid/ec/evidence-contract-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "const": "EC-SECURITY-PRIMITIVE-CATALOG-V2"
    },
    "contract_id": {
      "$ref": "#/$defs/id"
    },
    "contract_version": {
      "const": "EC-EVIDENCE-CONTRACT-V3"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidenceItem"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/target"
    }
  },
  "required": [
    "contract_version",
    "contract_id",
    "catalog_id",
    "target",
    "evidence"
  ],
  "title": "EC Evidence Contract V3",
  "type": "object"
}
