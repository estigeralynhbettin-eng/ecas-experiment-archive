{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ec/field-security-proposal-v2.schema.json",
  "title": "EC Field Security Proposal or Abstention V2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_version", "candidate_id", "decision", "policy"],
      "properties": {
        "proposal_version": {"const": "EC-FIELD-PROPOSAL-V2"},
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "decision": {"const": "propose"},
        "policy": {"$ref": "https://example.invalid/ec/field-security-policy-v2.schema.json"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_version", "candidate_id", "decision", "reason_code", "missing_evidence"],
      "properties": {
        "proposal_version": {"const": "EC-FIELD-PROPOSAL-V2"},
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "decision": {"const": "abstain"},
        "reason_code": {"enum": ["missing_business_binding", "missing_api_binding", "missing_context", "conflicting_evidence", "unsupported_primitive", "non_actionable_material"]},
        "missing_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  ]
}
