      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "const": "abstain"
        },
        "evidence_refs": {
          "maxItems": 0,
          "type": "array"
        },
        "ir_version": {
          "const": "EC-FIELD-MODEL-IR-V3"
        },
        "missing_evidence": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "policy_id": {
          "const": "none"
        },
        "reason_code": {
          "enum": [
            "missing_business_binding",
            "missing_api_binding",
            "missing_context",
            "conflicting_evidence",
            "unsupported_primitive",
            "non_actionable_material"
          ]
        },
        "rules": {
          "maxItems": 0,
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
