      "required": [
        "ir_version",
        "candidate_id",
        "decision",
        "target",
        "policy_id",
        "evidence_refs",
        "rules",
        "reason_code",
        "missing_evidence"
      ],
      "type": "object"
    },
    "baseRuleProperties": {
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        }
      },
      "type": "object"
    },
    "evidenceRefs": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "pointer": {
      "maxLength": 512,
      "pattern": "^/(request|trusted)(/([^~/]|~0|~1)+|/\\*)*$",
      "type": "string"
    },
    "propose": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "const": "propose"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "ir_version": {
          "const": "EC-FIELD-MODEL-IR-V3"
        },
        "missing_evidence": {
          "maxItems": 0,
          "type": "array"
        },
        "policy_id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "not": {
                "const": "none"
              }
            }
          ]
        },
        "reason_code": {
          "const": "none"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/rule"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
