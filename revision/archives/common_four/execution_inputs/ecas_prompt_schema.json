      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "system",
        "version",
        "operation"
      ],
      "type": "object"
    }
  },
